 REGISTER_FACTORY(GenericHashableStringObjectFactory, StreamInfo::FilterState::ObjectFactory);
 
+// Expose the legacy ext_proc peer fields without Istio peer discovery.
+class LegacyDownstreamPeer : public StreamInfo::FilterState::Object {
+public:
+  LegacyDownstreamPeer(absl::string_view name, absl::string_view name_space)
+      : name_(name), namespace_(name_space) {}
+
+  bool hasFieldSupport() const override { return true; }
+  FieldType getField(absl::string_view field) const override {
+    if (field == "name") {
+      return absl::string_view(name_);
+    }
+    if (field == "namespace") {
+      return absl::string_view(namespace_);
+    }
+    return absl::monostate{};
+  }
+
+private:
+  const std::string name_;
+  const std::string namespace_;
+};
+
+class LegacyDownstreamPeerFactory : public StreamInfo::FilterState::ObjectFactory {
+public:
+  std::string name() const override { return "agentio.legacy_downstream_peer"; }
+  std::unique_ptr<StreamInfo::FilterState::Object>
+  createFromBytes(absl::string_view data) const override {
+    // Kubernetes workload names and namespaces cannot contain a newline.
+    const auto separator = data.find('\n');
+    if (separator == absl::string_view::npos || separator == 0 || separator + 1 == data.size() ||
+        data.find('\n', separator + 1) != absl::string_view::npos) {
+      return nullptr;
+    }
+    return std::make_unique<LegacyDownstreamPeer>(data.substr(0, separator),
+                                                data.substr(separator + 1));
+  }
+};
+
+REGISTER_FACTORY(LegacyDownstreamPeerFactory, StreamInfo::FilterState::ObjectFactory);
