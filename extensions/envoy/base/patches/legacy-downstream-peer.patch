+TEST_F(ConfigTest, LegacyDownstreamPeerFields) {
+  initialize({R"YAML(
+    object_key: downstream_peer
+    factory_key: agentio.legacy_downstream_peer
+    format_string:
+      text_format_source:
+        inline_string: "sandbox-1\nproduction"
+  )YAML"});
+  update();
+  const auto* peer = info_.filterState()->getDataReadOnlyGeneric("downstream_peer");
+  ASSERT_NE(nullptr, peer);
+  EXPECT_TRUE(peer->hasFieldSupport());
+  EXPECT_EQ("sandbox-1", absl::get<absl::string_view>(peer->getField("name")));
+  EXPECT_EQ("production", absl::get<absl::string_view>(peer->getField("namespace")));
+  EXPECT_TRUE(absl::holds_alternative<absl::monostate>(peer->getField("labels")));
+  EXPECT_EQ(0, info_.filterState()->objectsSharedWithUpstreamConnection()->size());
+}
+
+TEST_F(ConfigTest, LegacyDownstreamPeerRejectsIncompleteIdentity) {
+  const auto* factory =
+      Registry::FactoryRegistry<StreamInfo::FilterState::ObjectFactory>::getFactory(
+          "agentio.legacy_downstream_peer");
+  ASSERT_NE(nullptr, factory);
+  for (const absl::string_view value : {"", "sandbox-1", "\nproduction", "sandbox-1\n",
+                                      "sandbox-1\nproduction\nextra"}) {
+    EXPECT_EQ(nullptr, factory->createFromBytes(value));
+  }
+}
